# Dashboard/API login secret. If unset, a temporary token is generated at
# startup and written to the server log; it changes on every restart.
API_TOKEN=CHOOSE_A_LONG_RANDOM_SECRET
# SEC asks automated clients to identify themselves. An app URL or monitored
# email address is suitable contact information.
SEC_USER_AGENT=BaselTrader/1.0 your-email@example.com

ALPACA_API_KEY=PUT_PAPER_KEY_HERE
ALPACA_API_SECRET=PUT_PAPER_SECRET_HERE
ALPACA_PAPER=true
ENABLE_PAPER_ORDERS=false
AUTO_PAPER_TRADING=false
# STANDARD refuses to enter while SPY/QQQ are risk-off; AGGRESSIVE only tags a
# caution. Measured over 125 sessions STANDARD won on every metric:
# +14.96% vs +13.05%, drawdown 3.60% vs 6.51%, Sharpe 2.79 vs 1.99.
TRADING_PROFILE=STANDARD
SCAN_EXTENDED_HOURS=true

OPTION_ALPHA_WEBHOOK_URL=
OPTION_ALPHA_ENABLED=false

PAPER_EQUITY=20000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=4
MAX_POSITION_NOTIONAL_PCT=0.20
MAX_GROSS_EXPOSURE_PCT=0.60
MAX_PORTFOLIO_HEAT_PCT=0.02
BUYING_POWER_BUFFER_PCT=0.05
# Quantity is automatically reduced to these participation ceilings.
MAX_BAR_PARTICIPATION_PCT=0.05
MAX_DAILY_PARTICIPATION_PCT=0.001
REQUIRE_LIQUIDITY_FOR_ORDERS=true

# نطاق السعر مفتوح: السبريد والحجم النسبي هما الفلتر الفعلي.
MIN_PRICE=0.01
# 0 means no upper price cap.
MAX_PRICE=0
MIN_CHANGE_PCT=1.5
MIN_EXECUTION_CHANGE_PCT=3.0
# 0 keeps large movers visible instead of discarding them.
MAX_CHANGE_PCT=0
MIN_SCORE=72
MIN_INTEL_SCORE=72
MAX_SPREAD_PCT=0.65
MAX_SPREAD_LOW_PRICE_PCT=1.50
MAX_SPREAD_PENNY_PCT=3.00
MOVERS_TOP=50
ACTIVES_TOP=100
SCREENER_UNIVERSE_LIMIT=100
SCAN_INTERVAL_SECONDS=30

MAX_VWAP_EXTENSION_PCT=4.5
MAX_EMA20_EXTENSION_PCT=6.0
MAX_ONE_BAR_MOVE_PCT=5.0
# EMA20 needs its own period of bars before it means anything; below 20 the
# trend filters pass on a seeding artefact.
MIN_INTRADAY_BARS=25
MIN_STOP_PCT=0.8
MAX_STOP_PCT=7.5
REWARD_R_MULTIPLE=2.0
SYMBOL_COOLDOWN_MINUTES=30
REQUIRE_FRESH_MARKET_DATA=true
MAX_MARKET_DATA_AGE_SECONDS=90
MAX_INTRADAY_BAR_AGE_SECONDS=180
# Circuit breakers, ported in spirit from Freqtrade's protections. The daily
# equity limit never fired across 44 backtested sessions while a losing exit
# bucket bled $3,514 in instalments, so these judge the recent record instead.
PROTECTIONS_ENABLED=true
GUARD_LOSS_TRADES=4
GUARD_LOSS_LOOKBACK_MINUTES=120
GUARD_LOSS_LOCK_MINUTES=90
GUARD_DRAWDOWN_PCT=0.02
GUARD_DRAWDOWN_LOOKBACK_MINUTES=390
GUARD_DRAWDOWN_MIN_TRADES=5
GUARD_DRAWDOWN_LOCK_MINUTES=180
GUARD_SYMBOL_TRADES=3
GUARD_SYMBOL_LOOKBACK_MINUTES=1440
GUARD_SYMBOL_LOCK_MINUTES=240

MIN_RVOL=1.2
OPENING_DELAY_MINUTES=2

# Extended session. The broker accepts only plain limit orders outside
# 09:30-16:00 -- no bracket, no OTO, no market order -- so an after-hours
# position has no broker-side stop and the bot enforces one in software.
# That protection stops the moment the process does.
TRADE_AFTER_HOURS=true
TRADE_PRE_MARKET=false

# Runner exits: 2R is a measurement reference, not a fixed sell order. After
# expansion, the manager waits for two confirmed reversal checks before exit.
RUNNER_MODE=true
RUNNER_ACTIVATE_R=2.0
RUNNER_GIVEBACK_FRACTION=0.35
RUNNER_MIN_LOCK_R=1.0
RUNNER_EXIT_CHECKS=2
FLATTEN_UNPROTECTED_POSITIONS=true
UNPROTECTED_POSITION_GRACE_CHECKS=3

# End of day. Protective stop legs are day orders, so anything still open when
# they expire carries overnight with no stop. Times are measured against the
# broker's own next_close (plus the extended session when it is on), so
# early-close days are handled.
EOD_FLATTEN_ENABLED=true
EOD_FLATTEN_MINUTES_BEFORE_CLOSE=10
NO_ENTRY_MINUTES_BEFORE_CLOSE=30
