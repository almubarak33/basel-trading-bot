# Dashboard/API login secret. If unset, a temporary token is generated at
# startup and written to the server log; it changes on every restart.
API_TOKEN=CHOOSE_A_LONG_RANDOM_SECRET
# SEC asks automated clients to identify themselves. An app URL or monitored
# email address is suitable contact information.
SEC_USER_AGENT=BaselTrader/1.0 your-email@example.com

ALPACA_API_KEY=PUT_PAPER_KEY_HERE
ALPACA_API_SECRET=PUT_PAPER_SECRET_HERE
ALPACA_PAPER=true
ENABLE_PAPER_ORDERS=false
AUTO_PAPER_TRADING=false
TRADING_PROFILE=AGGRESSIVE
SCAN_EXTENDED_HOURS=true

OPTION_ALPHA_WEBHOOK_URL=
OPTION_ALPHA_ENABLED=false

PAPER_EQUITY=20000
RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=4
MAX_POSITION_NOTIONAL_PCT=0.20

MIN_PRICE=0.01
# 0 means no upper price cap.
MAX_PRICE=0
MIN_CHANGE_PCT=1.5
MIN_EXECUTION_CHANGE_PCT=3.0
# 0 keeps large movers visible instead of discarding them.
MAX_CHANGE_PCT=0
MIN_SCORE=72
MIN_INTEL_SCORE=72
MAX_SPREAD_PCT=0.65
MAX_SPREAD_LOW_PRICE_PCT=1.50
MAX_SPREAD_PENNY_PCT=3.00
MOVERS_TOP=50
ACTIVES_TOP=100
SCREENER_UNIVERSE_LIMIT=100
SCAN_INTERVAL_SECONDS=30

MAX_VWAP_EXTENSION_PCT=4.5
MAX_EMA20_EXTENSION_PCT=6.0
MAX_ONE_BAR_MOVE_PCT=5.0
MIN_INTRADAY_BARS=8
MIN_STOP_PCT=0.8
MAX_STOP_PCT=7.5
REWARD_R_MULTIPLE=2.0
SYMBOL_COOLDOWN_MINUTES=30
MIN_RVOL=1.2
OPENING_DELAY_MINUTES=2

# Runner exits: 2R is a measurement reference, not a fixed sell order. After
# expansion, the manager waits for two confirmed reversal checks before exit.
RUNNER_MODE=true
RUNNER_ACTIVATE_R=2.0
RUNNER_GIVEBACK_FRACTION=0.35
RUNNER_MIN_LOCK_R=1.0
RUNNER_EXIT_CHECKS=2

# End of day. Protective stop legs are day orders, so anything still open when
# they expire carries overnight with no stop. Times are measured against the
# broker's own next_close, so early-close days are handled.
EOD_FLATTEN_ENABLED=true
EOD_FLATTEN_MINUTES_BEFORE_CLOSE=10
NO_ENTRY_MINUTES_BEFORE_CLOSE=30
